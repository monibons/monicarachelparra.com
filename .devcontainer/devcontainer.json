{
  "name": "Jekyll",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/ruby:1": { "version": "3.3" }
  },
  "postCreateCommand": "gem install bundler && bundle config set path 'vendor/bundle' && bundle install",
  "forwardPorts": [4000],
  "portsAttributes": { "4000": { "label": "Jekyll" } },
  "customizations": {
    "vscode": {
      "extensions": ["rebornix.Ruby"]
    }
  }
}
